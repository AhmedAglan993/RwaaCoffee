rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // البريد الداخلي لحساب الدخول = اسم المستخدم + @rwaa.com
    // (اسم المستخدم: heely)
    function isOwner() {
      return request.auth != null
          && request.auth.token.email == 'heely@rwaa.com';
    }

    match /customers/{phone} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone == phone
        && request.resource.data.beans is string
        && request.resource.data.beans.size() > 0 && request.resource.data.beans.size() <= 120;
    }

    // قائمة أنواع البن
    match /settings/beans {
      allow read: if isOwner();
      allow write: if isOwner()
        && request.resource.data.types is list
        && request.resource.data.types.size() <= 200;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
